{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    // The published tarball ships only `dist/`, never `src/`, so source and
    // declaration maps would point at files consumers do not have. Leaving
    // them out keeps the npm artifact roughly a third smaller.
    "sourceMap": false,
    "declarationMap": false
  },
  "include": ["src"],
  "exclude": ["src/client", "test"]
}
