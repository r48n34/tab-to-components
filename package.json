{
  "name": "tab-to-components-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "pnpm --filter tab-to-components build",
    "dev:lib": "pnpm --filter tab-to-components dev",
    "typecheck": "pnpm --filter tab-to-components typecheck",
    "test": "pnpm build && pnpm --filter tab-to-components test",
    "test:dev-only": "pnpm --filter tab-to-components test:dev-only",
    "test:integration": "pnpm build && pnpm --filter tab-to-components test:integration",
    "test:matrix": "pnpm build && pnpm --filter tab-to-components test:matrix",
    "install:compat": "pnpm --dir compat/react18 install --frozen-lockfile && pnpm --dir compat/react18-rr6 install --frozen-lockfile && pnpm --dir compat/react19-rr6 install --frozen-lockfile && pnpm --dir compat/remix2-react18 install --frozen-lockfile",
    "test:compat": "pnpm build && node scripts/compat-matrix.mjs",
    "test:compat:full": "pnpm build && node scripts/compat-matrix.mjs --browser --write-doc",
    "verify:package": "pnpm build && pnpm --filter tab-to-components verify:package",
    "e2e": "pnpm build && node scripts/e2e.mjs",
    "gate": "pnpm build && pnpm typecheck && pnpm --filter tab-to-components test && pnpm test:integration && pnpm test:matrix && pnpm test:compat && pnpm verify:package"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "typescript": "5.9.3"
  }
}
